{
  "default": "example-docs",
  "targets": {
    "example-docs": {
      "type": "http-rest",
      "url": "https://docs.example.com/api/upload/doc",
      "token_env": "DOC_PUBLISHER_TOKEN",
      "auth": "header",
      "verify": {
        "url": "https://docs.example.com/guide",
        "mode": "available",
        "attempts": 3,
        "interval": 1
      },
      "description": "Replace the example endpoint; available checks accessibility only"
    },
    "local-preview": {
      "type": "local-copy",
      "dest": "./dist/docs.md",
      "description": "Atomic file copy; does not start a preview server"
    }
  }
}
